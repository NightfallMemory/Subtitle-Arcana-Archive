Dialogue: 0,0:22:29.20,0:22:29.61,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(545,45)}Antsy...
Dialogue: 1,0:22:29.44,0:22:33.14,italicstop,,0,0,0,,Impatient love
Dialogue: 0,0:22:29.61,0:22:30.03,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(400,45)}Antsy...
Dialogue: 0,0:22:29.61,0:22:30.03,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(575,80)}Antsy...
Dialogue: 0,0:22:30.03,0:22:30.45,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(410,85)}Antsy...
Dialogue: 0,0:22:30.03,0:22:30.45,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(545,45)}Antsy...
Dialogue: 0,0:22:30.45,0:22:30.87,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(400,45)}Antsy...
Dialogue: 0,0:22:30.45,0:22:30.87,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(575,80)}Antsy...
Dialogue: 0,0:22:30.87,0:22:31.28,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(410,85)}Antsy...
Dialogue: 0,0:22:30.87,0:22:31.28,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(545,45)}Antsy...
Dialogue: 0,0:22:31.28,0:22:31.70,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(400,45)}Antsy...
Dialogue: 0,0:22:31.28,0:22:31.70,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(575,80)}Antsy...
Dialogue: 0,0:22:31.70,0:22:32.12,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(410,85)}Antsy...
Dialogue: 0,0:22:31.70,0:22:32.12,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(545,45)}Antsy...
Dialogue: 0,0:22:32.12,0:22:32.53,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(400,45)}Antsy...
Dialogue: 0,0:22:32.12,0:22:32.53,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(575,80)}Antsy...
Dialogue: 0,0:22:32.53,0:22:32.95,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(410,85)}Antsy...
Dialogue: 0,0:22:32.53,0:22:32.95,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(545,45)}Antsy...
Dialogue: 0,0:22:32.95,0:22:33.37,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(400,45)}Antsy...
Dialogue: 0,0:22:32.95,0:22:33.37,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(575,80)}Antsy...
Dialogue: 0,0:22:33.37,0:22:33.79,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(410,85)}Antsy...
Dialogue: 0,0:22:33.37,0:22:33.79,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(545,45)}Antsy...
Dialogue: 0,0:22:33.79,0:22:34.20,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(400,45)}Antsy...
Dialogue: 0,0:22:33.79,0:22:34.20,sign_32339_416_Antsy___,sign,0,0,0,,{\pos(575,80)}Antsy...
