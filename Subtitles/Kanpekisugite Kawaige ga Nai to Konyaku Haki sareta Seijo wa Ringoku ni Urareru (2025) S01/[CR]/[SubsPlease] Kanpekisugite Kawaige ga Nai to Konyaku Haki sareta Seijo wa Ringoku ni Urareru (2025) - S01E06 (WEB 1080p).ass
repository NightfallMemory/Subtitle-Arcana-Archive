Dialogue: 0,0:23:35.01,0:23:40.02,Default,Sign,0,0,0,,{\shad1\bord0\an8\fnGeorgia\c&HFBFFFF&\3c&H4E4E4E&\fs20\4c&H6A6763&\b1\pos(320,255)}"The Imprisoned {\fs24\c&HF4A04E&\4c&HFFFFFF&}Prince{\fs20\c&HFBFFFF&\4c&H6A6763&}"
Dialogue: 0,0:23:36.11,0:23:37.79,Default,Philia,0,0,0,,"The Imprisoned Prince."
