Dialogue: 0,0:01:46.46,0:01:52.29,Caption,,0,0,0,,{\pos(806.4,612)}{\an7}FILE: Forgetter Annette
Dialogue: 0,0:04:49.75,0:04:51.67,Caption,,0,0,0,,{\pos(460.8,612)}{\an7}After Day 1 on the Job
Dialogue: 0,0:05:08.38,0:05:10.17,Caption,,0,0,0,,{\pos(512,576)}{\an7}Day 2 on the Job
Dialogue: 0,0:05:39.58,0:05:41.58,Caption,,0,0,0,,{\pos(512,576)}{\an7}Day 3 on the Job
Dialogue: 0,0:06:13.75,0:06:16.75,Caption,,0,0,0,,{\pos(512,583.2)}{\an7}Day 4 on the Job
Dialogue: 0,0:12:41.38,0:12:44.96,Caption,,0,0,0,,{\pos(640,144)}{\an7}FILE: Forgetter Annette
