Dialogue: 0,0:07:44.23,0:07:46.53,sign_harsh_red,Sign,0,0,0,,{\an7\fade(500,1)\3c&H090203&\pos(24.502,163.539)}Strength:
Dialogue: 0,0:07:44.23,0:07:46.53,sign_harsh_red,Sign,0,0,0,,{\an7\fade(500,1)\3c&H090203&\pos(23.772,201.511)}Magic:
Dialogue: 0,0:07:44.23,0:07:46.53,sign_harsh_red,Sign,0,0,0,,{\an7\fade(500,1)\3c&H090203&\pos(23.772,242.768)}Spirit:
Dialogue: 0,0:07:44.23,0:07:46.53,sign_harsh_red,Sign,0,0,0,,{\an7\fade(500,1)\3c&H090203&\pos(24.137,280.374)}Agility:
Dialogue: 0,0:07:44.23,0:07:46.53,sign_harsh_red,Sign,0,0,0,,{\an7\fade(500,1)\3c&H090203&\pos(454.173,88.326)}[Skills]
